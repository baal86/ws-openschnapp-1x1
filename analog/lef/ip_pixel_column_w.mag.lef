VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO ip_pixel_column_w
  CLASS BLOCK ;
  FOREIGN ip_pixel_column_w ;
  ORIGIN 0.000 0.000 ;
  SIZE 2420.000 BY 480.000 ;
  PIN VSS
    USE POWER ;
    PORT
      LAYER Metal4 ;
        RECT -5.000 235.000 10.000 335.000 ;
    END
  END VSS
  PIN VDD
    USE POWER ;
    PORT
      LAYER Metal4 ;
        RECT -5.000 340.000 10.000 480.000 ;
    END
  END VDD
  PIN sf_out
    DIRECTION INOUT ;
    USE SIGNAL ;
    PORT
      LAYER Metal2 ;
        RECT 0.000 20.000 10.000 25.000 ;
    END
  END sf_out
  OBS
      LAYER Nwell ;
        RECT 0.000 0.000 2420.000 480.000 ;
      LAYER Metal1 ;
        RECT -5.000 340.000 2420.000 480.000 ;
        RECT 0.000 335.000 2420.000 340.000 ;
        RECT -5.000 235.000 2420.000 335.000 ;
        RECT 0.000 0.000 2420.000 235.000 ;
      LAYER Metal2 ;
        RECT -5.000 340.000 2420.000 480.000 ;
        RECT 0.000 335.000 2420.000 340.000 ;
        RECT -5.000 235.000 2420.000 335.000 ;
        RECT 0.000 25.300 2420.000 235.000 ;
        RECT 10.300 19.700 2420.000 25.300 ;
        RECT 0.000 0.000 2420.000 19.700 ;
      LAYER Metal3 ;
        RECT -5.000 340.000 2420.000 480.000 ;
        RECT 0.000 335.000 2420.000 340.000 ;
        RECT -5.000 235.000 2420.000 335.000 ;
        RECT 0.000 0.000 2420.000 235.000 ;
      LAYER Metal4 ;
        RECT 10.300 339.700 2420.000 479.700 ;
        RECT 2.500 335.300 2420.000 339.700 ;
        RECT 10.300 234.700 2420.000 335.300 ;
        RECT 2.500 0.100 2420.000 234.700 ;
      LAYER Metal5 ;
        RECT 3.500 88.000 15.500 201.500 ;
  END
END ip_pixel_column_w
END LIBRARY

